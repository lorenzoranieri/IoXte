# Dipendenze e ambiente
node_modules/
.env
.env.*
!.env.example

# Dati runtime, log e segreti (non committare)
data/
logs/
*.log
*.pem
*.key
*secret*.txt
owner-login*.txt
session-secret.txt

# Promo: zip e media pesanti non servono al deploy
promo/*.zip
promo/*.mp4
promo/*.mp3
promo/_build/
promo/__pycache__/
**/__pycache__/

# Sistema
.DS_Store
.idea/
.vscode/

# Grafiche e font promo: restano in locale, non servono al deploy
promo/graphics/
promo/brand/*.png
promo/brand/fonts/
