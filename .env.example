# Porta del server (default 3055)
PORT=3055

# Chiave LLM: ne basta una. Priorità: XAI, OPENAI, ANTHROPIC.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelli opzionali (sovrascrivono i default)
XAI_MODEL=grok-4-fast
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe (checkout abbonamenti e ricariche crediti)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pubblico usato nei redirect di Stripe, es. https://ioxte.onrender.com
PUBLIC_URL=http://localhost:3055

# GitHub (Salva su GitHub / Gist)
GITHUB_TOKEN=
GITHUB_OWNER=

# Segreto per firmare i token di sessione (generane uno a caso in produzione)
SESSION_SECRET=cambia-questo-segreto

# WhatsApp Cloud API (Nia, assistente IoXte — equivalente Wingman)
# Token permanente di un System User Meta + ID del numero WhatsApp Business
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Stringa a tua scelta, la stessa da inserire nel webhook Meta
WHATSAPP_VERIFY_TOKEN=ioxte-verify
# Opzionale: segreto app per verificare X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Opzionale, chiamate in uscita (in attesa)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Account titolare creato al primo avvio se non esiste ancora (min 8 caratteri).
# In produzione su disco effimero (Render free) impostalo tu: altrimenti
# viene generata una password scritta solo in data/owner-login.txt.
OWNER_EMAIL=lorenzo@ioxte.local
OWNER_PASSWORD=
NODE_ENV=development
